# BlackBeetle Frontend Environment Variables
# Copy this file to .env and fill in the values

# ── Docker Dev-Umgebung ───────────────────────────────────────────
# Host-Port des Dev-Servers (3000 und 5173 sind lokal bereits belegt)
APP_PORT=3021
# UID/GID des Host-Users, damit Container-Dateien nicht root gehoeren
WWWUSER=1000
WWWGROUP=1001

# ── API ───────────────────────────────────────────────────────────
# Browser-seitig. Leer = relative /api/v1/... auf der eigenen Origin; darum
# kuemmern sich Caddy (Domain) bzw. der devProxy aus nuxt.config.ts (localhost).
# Das vermeidet CORS und Mixed Content. Nur setzen, wenn die API bewusst unter
# einer anderen Origin liegen soll.
NUXT_PUBLIC_API_BASE=

# Serverseitig (SSR im Container): localhost zeigt dort auf den Container
# selbst. Der Weg ueber den Host-Gateway scheitert, weil bb-backend nur auf
# 127.0.0.1 published — deshalb direkt der Container im gemeinsamen Netz
# (Port 80). Leer lassen, wenn der Dev-Server nicht in Docker laeuft.
NUXT_API_BASE_INTERNAL=http://bb-backend-app

# Basis fuer Medien-URLs. Muss zur Origin passen, unter der du die App
# aufrufst (siehe auch APP_URL im Backend).
NUXT_PUBLIC_BACKEND_URL=https://bb-frontend.blacknectar.de

# LightGallery License Key (optional, for production use)
NUXT_PUBLIC_LG_LICENSE_KEY=

# ── Optional: Zugriff ueber Reverse-Proxy/Domain ──────────────────
# Gesetzt -> allowedHosts und HMR ueber wss gegen diesen Host. Leer lassen
# fuer rein lokale Entwicklung ueber localhost.
NUXT_DEV_HOST=bb-frontend.blacknectar.de
